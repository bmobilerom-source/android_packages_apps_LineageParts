<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:lineage="http://schemas.android.com/apk/res-auto"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:key="dynamic_island_settings"
    android:title="@string/dynamic_island_settings_title">

    <PreferenceCategory android:title="@string/dynamic_island_general_category">
        <lineageos.preference.LineageSystemSettingSwitchPreference
            android:key="status_bar_dynamic_island"
            android:title="@string/dynamic_island_enable_title"
            android:summary="@string/dynamic_island_enable_summary"
            android:defaultValue="false" />

        <lineageos.preference.LineageSystemSettingSwitchPreference
            android:key="status_bar_dynamic_island_auto_cutout"
            android:title="@string/dynamic_island_auto_cutout_title"
            android:summary="@string/dynamic_island_auto_cutout_summary"
            android:defaultValue="false"
            android:dependency="status_bar_dynamic_island" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/dynamic_island_plugins_category">
        <lineageos.preference.LineageSystemSettingSwitchPreference
            android:key="status_bar_dynamic_island_plugin_notification"
            android:title="@string/dynamic_island_plugin_notification_title"
            android:defaultValue="true" />

        <lineageos.preference.LineageSystemSettingSwitchPreference
            android:key="status_bar_dynamic_island_suppress_system_notifications"
            android:title="@string/dynamic_island_suppress_system_notifications_title"
            android:summary="@string/dynamic_island_suppress_system_notifications_summary"
            android:defaultValue="false"
            android:dependency="status_bar_dynamic_island_plugin_notification" />

        <lineageos.preference.LineageSystemSettingSwitchPreference
            android:key="status_bar_dynamic_island_plugin_call"
            android:title="@string/dynamic_island_plugin_call_title"
            android:summary="@string/dynamic_island_plugin_call_summary"
            android:defaultValue="true" />

        <lineageos.preference.LineageSystemSettingSwitchPreference
            android:key="status_bar_dynamic_island_plugin_media"
            android:title="@string/dynamic_island_plugin_media_title"
            android:defaultValue="true" />

        <lineageos.preference.LineageSystemSettingSwitchPreference
            android:key="status_bar_dynamic_island_plugin_battery"
            android:title="@string/dynamic_island_plugin_battery_title"
            android:defaultValue="true" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="dynamic_island_apps_category"
        android:title="@string/dynamic_island_apps_category">
        <Preference
            android:key="dynamic_island_enabled_apps"
            android:title="@string/dynamic_island_enabled_apps_title"
            android:summary="@string/dynamic_island_enabled_apps_all" />

        <Preference
            android:key="dynamic_island_add_app"
            android:title="@string/dynamic_island_add_app_title"
            android:summary="@string/dynamic_island_add_app_summary" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/dynamic_island_behavior_category">
        <!-- Peek-only temporarily disabled pending additional device soak validation. -->
        <!--
        <lineageos.preference.LineageSystemSettingSwitchPreference
            android:key="status_bar_dynamic_island_peek_only"
            android:title="@string/dynamic_island_peek_only_title"
            android:summary="@string/dynamic_island_peek_only_summary"
            android:defaultValue="false"
            android:dependency="status_bar_dynamic_island_plugin_notification" />
        -->

        <lineageos.preference.LineageSystemSettingSwitchPreference
            android:key="status_bar_dynamic_island_badge_opens_shade"
            android:title="@string/dynamic_island_badge_opens_shade_title"
            android:summary="@string/dynamic_island_badge_opens_shade_summary"
            android:defaultValue="true"
            android:dependency="status_bar_dynamic_island_plugin_notification" />

        <lineageos.preference.LineageSystemSettingSwitchPreference
            android:key="status_bar_dynamic_island_priority_styling"
            android:title="@string/dynamic_island_priority_styling_title"
            android:summary="@string/dynamic_island_priority_styling_summary"
            android:defaultValue="true"
            android:dependency="status_bar_dynamic_island_plugin_notification" />

        <!-- Navigation hints temporarily disabled pending additional device soak validation. -->
        <!--
        <lineageos.preference.LineageSystemSettingSwitchPreference
            android:key="status_bar_dynamic_island_navigation_hints"
            android:title="@string/dynamic_island_navigation_hints_title"
            android:summary="@string/dynamic_island_navigation_hints_summary"
            android:defaultValue="false"
            android:dependency="status_bar_dynamic_island_plugin_notification" />
        -->
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/dynamic_island_appearance_category">
        <lineageos.preference.LineageSystemSettingSwitchPreference
            android:key="status_bar_dynamic_island_monet_tint"
            android:title="@string/dynamic_island_monet_tint_title"
            android:summary="@string/dynamic_island_monet_tint_summary"
            android:defaultValue="false" />

        <lineageos.preference.LineageSystemSettingListPreference
            android:key="status_bar_dynamic_island_theme"
            android:title="@string/dynamic_island_theme_title"
            android:entries="@array/dynamic_island_theme_entries"
            android:entryValues="@array/dynamic_island_theme_values"
            android:defaultValue="0"
            settings:layout="@layout/adaptive_preference_card" />

        <!-- Island position (gravity) hidden — defaults to center below notch -->
        <!--
        <lineageos.preference.LineageSystemSettingListPreference
            android:key="status_bar_dynamic_island_gravity"
            android:title="@string/dynamic_island_gravity_title"
            android:summary="@string/dynamic_island_gravity_summary"
            android:entries="@array/dynamic_island_gravity_entries"
            android:entryValues="@array/dynamic_island_gravity_values"
            android:defaultValue="0"
            settings:layout="@layout/adaptive_preference_card" />
        -->

        <org.lineageos.lineageparts.statusbar.DynamicIslandSeekBarPreference
            android:key="status_bar_dynamic_island_position_x"
            android:title="@string/dynamic_island_position_x_title"
            android:summary="@string/dynamic_island_position_x_summary" />

        <org.lineageos.lineageparts.statusbar.DynamicIslandSeekBarPreference
            android:key="status_bar_dynamic_island_position_y"
            android:title="@string/dynamic_island_position_y_title"
            android:summary="@string/dynamic_island_position_y_summary" />

        <org.lineageos.lineageparts.statusbar.DynamicIslandSeekBarPreference
            android:key="status_bar_dynamic_island_width"
            android:title="@string/dynamic_island_width_title"
            android:summary="@string/dynamic_island_width_summary" />

        <org.lineageos.lineageparts.statusbar.DynamicIslandSeekBarPreference
            android:key="status_bar_dynamic_island_height"
            android:title="@string/dynamic_island_height_title"
            android:summary="@string/dynamic_island_height_summary" />

        <!-- Corner radius hidden — uses default from LineageSettings -->
        <!--
        <org.lineageos.lineageparts.statusbar.DynamicIslandSeekBarPreference
            android:key="status_bar_dynamic_island_corner_radius"
            android:title="@string/dynamic_island_corner_radius_title"
            android:summary="@string/dynamic_island_corner_radius_summary" />
        -->

        <org.lineageos.lineageparts.statusbar.DynamicIslandSeekBarPreference
            android:key="status_bar_dynamic_island_auto_hide_ms"
            android:title="@string/dynamic_island_auto_hide_title"
            android:summary="@string/dynamic_island_auto_hide_summary" />
    </PreferenceCategory>

</PreferenceScreen>
